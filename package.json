{
  "name": "eurbe",
  "private": true,
  "type": "module",
  "scripts": {
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-eurbe \"node --test tests/rules/*.test.mjs\"",
    "emuladores": "firebase emulators:start --only auth,firestore --project demo-eurbe",
    "servir": "npx --yes http-server -p 5173 -c-1 .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.31.0"
  }
}
